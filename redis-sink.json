{
  "name": "redis-sink-connector",
  "config": {
    "connector.class": "com.redis.kafka.connect.RedisSinkConnector",
    "tasks.max": "1",
    "topics": "crypto.livestream",
    "redis.host": "redis",
    "redis.port": "6379",
    "redis.command": "HSET",
    "redis.key.template": "crypto:${symbol}:now",
    "_redis.type": "STREAM",
    "_transforms": "routeByPartition",
    "_transforms.routeByPartition.type": "io.confluent.connect.transforms.ExtractTopic$Key",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false" 
  }
}
